# Free-friendly AI provider
# Create this in Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Contentstack Delivery API
# Copy these from Stack > Settings > Tokens in Contentstack.
CONTENTSTACK_API_KEY=
CONTENTSTACK_DELIVERY_TOKEN=
CONTENTSTACK_ENVIRONMENT=development
CONTENTSTACK_REGION=us
CONTENTSTACK_DEFAULT_LOCALE=en-us

# MongoDB (local Docker or Atlas)
MONGODB_URI=mongodb://localhost:27017/synthara

# Better Auth
# Generate a 32+ character random string for BETTER_AUTH_SECRET.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (optional for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend email delivery
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Synthara <onboarding@resend.dev>
RESEND_REPLY_TO=
MAIL_APP_NAME=Synthara
